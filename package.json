{
  "name": "abismo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && tsc -p server --noEmit",
    "test": "vitest run",
    "sim": "vitest run tests/sim.test.ts",
    "lan": "npm run build && npm run lan:server --",
    "lan:server": "esbuild server/lan.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/lan.mjs --log-level=warning && node dist-server/lan.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "puppeteer-core": "^23.11.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
